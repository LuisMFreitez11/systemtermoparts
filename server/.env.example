# Copia este archivo como server/.env si quieres una configuración propia del
# backend Node. Si no existe, se reutiliza legacy/backend/.env (mismas
# credenciales del backend PHP archivado).
#
# Prioridad: variables de entorno > server/.env > legacy/backend/.env > defaults.

APP_DEBUG=0
APP_TIMEZONE=America/Caracas

# Solo PostgreSQL/Supabase (el backend Node no implementa MariaDB).
DB_DRIVER=pgsql
DB_PGSQL_DSN="pgsql:host=TU-HOST.supabase.co;port=5432;dbname=postgres;sslmode=require"
DB_PGSQL_USER=postgres.TU-PROYECTO
DB_PGSQL_PASSWORD=TU-CLAVE

# Conexiones simultáneas por instancia. En Vercel conviene 3 o menos.
DB_POOL_MAX=3
DB_IDLE_TIMEOUT=10000
DB_CONNECT_TIMEOUT=10000

# Secreto de firma de la cookie de sesión. OBLIGATORIO en producción:
# si cambia, todas las sesiones abiertas se invalidan.
SESSION_SECRET=CAMBIA-ESTO-POR-UN-SECRETO-LARGO-Y-ALEATORIO
SESSION_NAME=TERMOPART_SESS
SESSION_LIFETIME=43200
# Con frontend y API en dominios distintos: None + Secure (requiere HTTPS).
SESSION_SAMESITE=Lax
SESSION_SECURE=0

# Orígenes del frontend autorizados (separados por coma).
CORS_ALLOWED_ORIGINS=https://tu-proyecto.vercel.app

# URL pública del frontend para redirecciones (opcional).
FRONTEND_URL=https://tu-proyecto.vercel.app

# Idempotencia de escrituras.
#   IDEMPOTENCY_WAIT: segundos que un reintento espera la respuesta del
#   primero antes de devolver 409 "en proceso". En Vercel, 4-5 es prudente.
IDEMPOTENCY_ENABLED=1
IDEMPOTENCY_TTL=604800
IDEMPOTENCY_IN_PROGRESS=120
IDEMPOTENCY_WAIT=8

# Puerto del servidor local (Vercel lo ignora).
PORT=3000
